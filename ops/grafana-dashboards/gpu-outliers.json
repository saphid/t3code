{
  "uid": "t3perf-gpu-outliers",
  "title": "T3 perf / GPU outliers",
  "tags": [
    "t3perf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, scenario)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "command-palette-open"
          ],
          "value": [
            "command-palette-open"
          ]
        }
      },
      {
        "name": "label",
        "label": "release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, label)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "network",
        "label": "network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, network)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "good"
          ],
          "value": [
            "good"
          ]
        }
      },
      {
        "name": "size",
        "label": "size",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, size)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "medium"
          ],
          "value": [
            "medium"
          ]
        }
      },
      {
        "name": "surface",
        "label": "surface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, surface)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "web"
          ],
          "value": [
            "web"
          ]
        }
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "GPU busy per feature (worst first, median)",
      "description": "Real GPU busy time per wall second (Apple Silicon AGX sampling), worst feature at the top. The app is almost entirely text: green (<10 ms/s) is expected, orange deserves a look, red (>50 ms/s) is report-an-outlier territory per the report heuristics.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(max by (host, scenario, surface, size, network) (last_over_time(t3perf_gpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", host=~\"$host\"}[$__range])))",
          "legendFormat": "{{host}} / {{scenario}} / {{surface}} / {{size}} / {{network}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "GPU process CPU per feature (worst first, median)",
      "description": "CPU of the Chromium GPU helper process per wall second, worst feature at the top. This is the rendering-cost signal on hosts without real GPU sampling (containers software-render, so values run higher there); use it to rank features against each other, not against the AGX thresholds.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(max by (host, scenario, surface, size, network) (last_over_time(t3perf_gpu_process_cpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", host=~\"$host\"}[$__range])))",
          "legendFormat": "{{host}} / {{scenario}} / {{surface}} / {{size}} / {{network}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU busy by build",
      "description": "Raw GPU busy time per feature across builds (one point per build). A line stepping up shows which build introduced an outlier. The dashed line marks the 50 ms/s report threshold.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, scenario, surface, size, network) (last_over_time(t3perf_gpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}} / {{scenario}} / {{surface}} / {{size}} / {{network}}"
        }
      ]
    }
  ],
  "version": 1
}

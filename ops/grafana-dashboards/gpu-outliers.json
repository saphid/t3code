{
  "uid": "t3perf-gpu-outliers",
  "title": "T3 perf / GPU outliers",
  "tags": [
    "t3perf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "scenario",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, scenario)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "scroll-giant-thread"
          ],
          "value": [
            "scroll-giant-thread"
          ]
        }
      },
      {
        "name": "label",
        "label": "release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, label)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "network",
        "label": "network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, network)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "good"
          ],
          "value": [
            "good"
          ]
        }
      },
      {
        "name": "size",
        "label": "size",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, size)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "medium"
          ],
          "value": [
            "medium"
          ]
        }
      },
      {
        "name": "surface",
        "label": "surface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, surface)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "web"
          ],
          "value": [
            "web"
          ]
        }
      },
      {
        "name": "device_type",
        "label": "device type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type!=\"\"}, device_type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "gpu_backend",
        "label": "GPU measurement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\"}, gpu_backend)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "host",
        "label": "worker host (drill-down)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms{time_basis=\"release\", device_type=~\"$device_type\", gpu_backend=~\"$gpu_backend\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Worst GPU cost seen in range",
      "description": "Worst median GPU busy time seen in the selected releases, ranked high to low. This is a triage ranking, not a statistical anomaly detector. It excludes gpu_backend=none because zero there means unavailable attribution. Yellow begins at 10 ms/s, orange at the 50 ms/s investigation marker, and red above the harness poor band of 100 ms/s.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(max by (device_type, gpu_backend, scenario, surface, size, network) (avg by (device_type, gpu_backend, scenario, surface, size, network, build) (last_over_time(t3perf_gpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", device_type=~\"$device_type\", gpu_backend=~\"$gpu_backend\", host=~\"$host\", gpu_backend!=\"none\"}[$__range]))))",
          "legendFormat": "{{device_type}} · {{gpu_backend}} · {{scenario}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Worst GPU-helper CPU cost seen in range",
      "description": "Worst median CPU time used by Chromium’s GPU helper per wall second. This is the honest rendering-cost signal for software-rendered Linux workers. Compare like device type and backend. Yellow begins at 10 ms/s, orange at 50 ms/s, and red above 100 ms/s.",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(max by (device_type, gpu_backend, scenario, surface, size, network) (avg by (device_type, gpu_backend, scenario, surface, size, network, build) (last_over_time(t3perf_gpu_process_cpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", device_type=~\"$device_type\", gpu_backend=~\"$gpu_backend\", host=~\"$host\"}[$__range]))))",
          "legendFormat": "{{device_type}} · {{gpu_backend}} · {{scenario}}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU busy by build",
      "description": "GPU busy time at each build’s release time. A sustained step across adjacent builds is stronger evidence than one isolated point. Thresholds mark attention at 10 ms/s, investigate at 50 ms/s, and the harness poor band above 100 ms/s.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms/s",
          "min": 0,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (device_type, gpu_backend, scenario, surface, size, network) (last_over_time(t3perf_gpu_ms_per_s{time_basis=\"release\", scenario=~\"$scenario\", stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", device_type=~\"$device_type\", gpu_backend=~\"$gpu_backend\", host=~\"$host\", gpu_backend!=\"none\"}[$__interval]))",
          "legendFormat": "{{device_type}} · {{gpu_backend}} · {{scenario}}"
        }
      ]
    }
  ],
  "version": 1,
  "description": "Worst GPU and GPU-process CPU cost seen across selected releases. Hardware is grouped by device type; measurement backend remains explicit so unlike signals are never averaged together.",
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,

{
  "uid": "t3perf-batch",
  "title": "T3 perf / Batch status",
  "version": 4,
  "tags": [
    "t3perf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_fleet_worker_heartbeat_unixtime, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fleet releases completed",
      "description": "Validated full/web releases completed by the scheduler. Worker values show the lxso1/lxso2/lxso3 share; Imported/legacy covers verified full runs completed before fleet attribution was recorded.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"completed\"}[10m]))",
          "legendFormat": "Fleet total",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (host) (last_over_time(t3perf_fleet_worker_completed{suite=\"full\",surface=\"web\",host=~\"$host\"}[10m]))",
          "legendFormat": "{{host}}",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "clamp_min(max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"completed\"}[10m])) - sum(max by (host) (last_over_time(t3perf_fleet_worker_completed{suite=\"full\",surface=\"web\"}[10m]))), 0)",
          "legendFormat": "Imported/legacy",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet releases failed",
      "description": "Scheduler jobs that ended without usable results. Zero is healthy.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data — investigate",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "No data — investigate"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"failed\"}[10m]))",
          "legendFormat": "Failed",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet queue depth",
      "description": "Discovered releases waiting for a worker. Newly discovered releases are inserted at the front of the newest-first queue.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 9,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"queued\"}[10m]))",
          "legendFormat": "Queued",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"leased\"}[10m]))",
          "legendFormat": "Leased",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max(last_over_time(t3perf_fleet_jobs{suite=\"full\",surface=\"web\",state=\"external\"}[10m]))",
          "legendFormat": "Held",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fleet worker heartbeat age",
      "description": "Seconds since lxso1, lxso2, and lxso3 last checked in with the scheduler.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 13,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data — investigate",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "No data — investigate"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (host) (last_over_time(t3perf_fleet_worker_heartbeat_unixtime{host=~\"$host\"}[7d]))",
          "legendFormat": "{{host}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet workers",
      "description": "Current worker state. Zero means idle and available; one means a release is running.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 17,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "green"
                },
                "1": {
                  "text": "busy",
                  "color": "blue"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data — investigate",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "No data — investigate"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (last_over_time(t3perf_fleet_worker_busy{host=~\"$host\"}[10m]))",
          "legendFormat": "{{host}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Discovery result",
      "description": "Outcome of the scheduler's latest npm registry check. A failed check is red even though its timestamp is recent.",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 21,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "No data — investigate"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_registry_refresh_success[7d]))",
          "legendFormat": "Latest check",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Current work",
      "description": "What each fleet worker is doing right now, including the assigned release when busy.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 4,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle"
                },
                "1": {
                  "text": "busy"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, version) (last_over_time(t3perf_fleet_worker_current{host=~\"$host\"}[2m]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "state"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Nightly discovery age",
      "description": "Seconds since the scheduler last checked npm for a newer nightly. Checks run every three hours; red means discovery is overdue.",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10800
              },
              {
                "color": "red",
                "value": 14400
              }
            ]
          },
          "noValue": "No data — investigate"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(last_over_time(t3perf_fleet_registry_refresh_unixtime[7d]))",
          "legendFormat": "Last registry check",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Legacy orchestrator: version duration",
      "description": "Historical duration emitted by the two pre-fleet orchestrators. Use Build trends for the complete cross-host release comparison.",
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 10,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (last_over_time(t3perf_batch_version_duration_ms{host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Legacy orchestrator: failed combos per completed version",
      "description": "Scenario/size combos the suite could not run for that version. Old nightlies legitimately fail scenarios whose UI did not exist yet, so a steady baseline is expected on historical builds; a jump on a recent build is a real signal. The version itself still counts as done and its passing combos are exported.",
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 17,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (last_over_time(t3perf_batch_version_combos_failed{host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Legacy orchestrator log",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"t3perf-orchestrator\", host=~\"$host\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Legacy harness output (per test run)",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"t3perf-harness\", host=~\"$host\"}"
        }
      ]
    }
  ]
}

{
  "uid": "t3perf-batch",
  "title": "T3 perf / Batch status",
  "version": 3,
  "tags": ["t3perf"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(t3perf_wall_ms, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fleet releases completed",
      "description": "The scheduler has completed 90 releases. Worker values show the lxso1/lxso3 share; Imported/legacy covers releases completed before fleet attribution was recorded.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{state=\"completed\"}[10m]))",
          "legendFormat": "Fleet total",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (host) (last_over_time(t3perf_fleet_worker_completed{host=~\"$host\"}[10m]))",
          "legendFormat": "{{host}}",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max(last_over_time(t3perf_fleet_jobs{state=\"completed\"}[10m])) - sum(max by (host) (last_over_time(t3perf_fleet_worker_completed[10m])))",
          "legendFormat": "Imported/legacy",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet releases failed",
      "description": "Scheduler jobs that ended without usable results. Zero is healthy.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{state=\"failed\"}[10m]))",
          "legendFormat": "Failed",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet queue depth",
      "description": "Discovered releases waiting for a worker. Newly discovered releases are inserted at the front of the newest-first queue.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time(t3perf_fleet_jobs{state=\"queued\"}[10m]))",
          "legendFormat": "Queued",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fleet worker heartbeat age",
      "description": "Seconds since lxso1/lxso3 last checked in with the scheduler.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (host) (last_over_time(t3perf_fleet_worker_heartbeat_unixtime{host=~\"$host\"}[10m]))",
          "legendFormat": "{{host}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet workers",
      "description": "Current worker state. Zero means idle and available; one means a release is running.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "green"
                },
                "1": {
                  "text": "busy",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, version) (last_over_time(t3perf_fleet_worker_busy{host=~\"$host\"}[10m]))",
          "legendFormat": "{{host}} / {{version}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Current work",
      "description": "What each fleet worker is doing right now, including the assigned release when busy.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle"
                },
                "1": {
                  "text": "busy"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host, version) (last_over_time(t3perf_fleet_worker_busy{host=~\"$host\"}[10m]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "state"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Legacy orchestrator: version duration",
      "description": "Historical duration emitted by the two pre-fleet orchestrators. Use Build trends for the complete cross-host release comparison.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (last_over_time(t3perf_batch_version_duration_ms{host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Legacy orchestrator: failed combos per completed version",
      "description": "Scenario/size combos the suite could not run for that version. Old nightlies legitimately fail scenarios whose UI did not exist yet, so a steady baseline is expected on historical builds; a jump on a recent build is a real signal. The version itself still counts as done and its passing combos are exported.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host) (last_over_time(t3perf_batch_version_combos_failed{host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Legacy orchestrator log",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"t3perf-orchestrator\", host=~\"$host\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Legacy harness output (per test run)",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"t3perf-harness\", host=~\"$host\"}"
        }
      ]
    }
  ]
}

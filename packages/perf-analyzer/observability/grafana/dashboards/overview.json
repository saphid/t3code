      "targets": [
        {
          "refId": "A",
          "expr": "label_join(max by (build, scenario, surface) (last_over_time(t3perf_gpu_process_cpu_ms_per_s{stat=\"median\", build!=\"\", label=~\"$label\", network=~\"$network\", size=~\"$size\", surface=~\"$surface\", host=~\"$host\"}[$__range])), \"series\", \" / \", \"scenario\", \"surface\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [

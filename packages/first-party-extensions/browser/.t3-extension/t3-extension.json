{
  "format": 2,
  "manifest": {
    "id": "t3.browser",
    "version": "0.1.0",
    "apiVersion": 1,
    "surfaces": [
      {
        "id": "t3.browser/view",
        "title": "Browser",
        "scope": "thread",
        "placements": [
          "side-panel"
        ],
        "clients": [
          "web",
          "desktop"
        ],
        "capabilities": [],
        "stateVersion": 1
      }
    ]
  },
  "clientEntry": "client.mjs",
  "serverEntry": "server.mjs",
  "tools": [],
  "provides": [
    {
      "id": "t3.file/presentation",
      "version": "1.0.0",
      "methods": [
        {
          "name": "open",
          "effect": "read",
          "requiredGrants": [
            "t3.file/open"
          ],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relativePath"
            ],
            "properties": {
              "relativePath": {
                "type": "string",
                "maxLength": 512
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surfaceId",
              "placement",
              "restoreState"
            ],
            "properties": {
              "surfaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "placement": {
                "enum": [
                  "side-panel",
                  "bottom-dock",
                  "full-page",
                  "compact-detail"
                ]
              },
              "restoreState": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  ],
  "requires": [
    {
      "id": "t3.browser/sessions",
      "versionRange": "^1.1.0"
    },
    {
      "id": "t3.browser/local-servers",
      "versionRange": "^1.0.0"
    },
    {
      "id": "t3.browser/history",
      "versionRange": "^1.1.0"
    },
    {
      "id": "t3.browser/frames",
      "versionRange": "^1.0.0"
    },
    {
      "id": "t3.resources/lease",
      "versionRange": "^1.1.0"
    },
    {
      "id": "t3.ui/theme",
      "versionRange": "^1.0.0"
    },
    {
      "id": "t3.ui/keybindings",
      "versionRange": "^1.1.0"
    },
    {
      "id": "t3.ui/panels",
      "versionRange": "^1.0.0"
    },
    {
      "id": "t3.ui/notifications",
      "versionRange": "^1.0.0"
    },
    {
      "id": "t3.composer/context",
      "versionRange": "^1.2.0"
    },
    {
      "id": "t3.ui/external",
      "versionRange": "^1.0.0"
    }
  ],
  "dependencies": []
}

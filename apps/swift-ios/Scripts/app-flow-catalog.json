          "apps/swift-ios/Features/Settings/BuildTesting*.swift",
          "apps/swift-ios/Features/Settings/SettingsView.swift",
          "apps/swift-ios/Features/Workspace/PersonalBuildChannel.swift"
        ],
        "journeys": [
          "in-app-stream-approval-control",
          "development-build-source-thread"
        ]
      },
      {
        "id": "theme-settings",
        "patterns": [
          "apps/swift-ios/DesignSystem/T3ThemeRuntime.swift",
          "apps/swift-ios/Features/Settings/ThemeSettingsView.swift",
          "apps/swift-ios/Resources/theme-catalog-v1.json"
        ],
        "journeys": ["shared-electron-vscode-themes"]
      },
      {
        "id": "initial-thread-live-update",
        "patterns": [
          "apps/swift-ios/Features/Root/FeatureRootModel.swift",
          "apps/swift-ios/Features/Chat/ThreadDetailView.swift"
        ],
        "journeys": ["initial-thread-live-updates"]
      },
      {
        "id": "deterministic-app-flow-fixtures",
        "patterns": [
          "apps/swift-ios/App/AppFlowFixtureClient.swift",
          "apps/swift-ios/App/T3CodeApp.swift",
          "apps/swift-ios/UITests/AppFlowUITests.swift",
          "apps/swift-ios/UITests/AppFlowProofEventEmitter.swift"
        ],
        "journeys": [
          "in-app-stream-approval-control",
          "initial-thread-live-updates",
          "shared-electron-vscode-themes",
          "safe-tool-content-recovery",
          "development-build-source-thread",
          "proof-event-emitter-contract",
          "widget-channel-new-task",
          "pull-request-capability-gate",
          "pull-request-inbox-summary-timeline",
          "cold-boot-home-list-scrolling",
          "swiftui-test-personal-connect"
        ]
      },
      {
        "id": "widget-channel-links",
        "patterns": [
          "apps/swift-ios/Extensions/Shared/SharedContainer.swift",
          "apps/swift-ios/Extensions/Widgets/**",
          "apps/swift-ios/App/Platform/PlatformDeepLinks.swift",
          "apps/swift-ios/App/Platform/PlatformRootView.swift"
        ],
        "journeys": ["widget-channel-new-task"]
      },
      {
        "id": "pull-request-workspace",
        "patterns": [
          "apps/swift-ios/Core/PullRequestWireModels.swift",
          "apps/swift-ios/Features/PullRequests/**",
          "apps/swift-ios/Features/Workspace/WorkspaceView.swift"
        ],
        "journeys": [
          "pull-request-capability-gate",
          "pull-request-inbox-summary-timeline"
        ]
      },
      {
        "id": "composer-skills-popup",
        "patterns": [

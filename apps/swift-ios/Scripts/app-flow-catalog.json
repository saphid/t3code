{
  "schemaVersion": 1,
  "suite": "T3CodeUITests/AppFlowUITests",
  "journeys": [
    {
      "id": "onboarding-manual",
      "test": "testDirectConnectionOnboardingHappyPath",
      "lane": "fixture",
      "persona": "first-run-user",
      "estimatedSeconds": 30,
      "surfaces": ["manual connection", "secure pairing code", "Home"],
      "checkpoints": ["onboarding-connected-home"]
    },
    {

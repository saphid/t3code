  "plans": {
    "pr": {
      "description": "Fast deterministic gate for native pull requests.",
      "journeys": [
        "onboarding-manual",
        "workspace-navigation",
        "task-and-follow-up",
        "thread-workspace-tools"
      ]
    },
    "regression": {
      "description": "Complete deterministic fixture regression with no expected skips.",
      "journeys": [
        "onboarding-manual",
        "workspace-navigation",
        "new-task-options",
        "settings-secondary",
        "task-and-follow-up",
        "recovery-last-known-workspace",
        "permissions-denied-settings",
        "long-lived-history-search",
        "skills-popup-keyboard-readability",
        "home-thread-list-scrolling",
        "command-palette-top-drawer",
        "project-connection-entry",
        "thread-context-menu",
        "thread-workspace-tools"
      ]
    },
    "live": {
      "description": "Opt-in disposable-backend pairing and project-discovery smoke.",
      "journeys": ["live-pairing-project-discovery"]
    },
    "security": {
      "description": "Credential ingress and retained-evidence leak audit.",
      "journeys": ["credential-ingress-audit"]
    },
    "visual-accessibility": {
      "description": "Critical-screen semantic uniqueness and accessibility evidence lane.",
      "journeys": ["accessibility-critical-screens"]
    },
    "stability": {
      "description": "Three fresh-runner repetitions of the two critical fixture journeys; any first failure remains red.",
      "repetitions": 3,
      "journeys": ["onboarding-manual", "task-and-follow-up"]
    },
    "known-red": {
      "description": "Explicit audit of issue-linked product defects; failures are expected until fixed.",
      "journeys": [
        "known-red-tool-sheet-close",
        "known-red-add-connection-close",
        "known-red-new-task-cancel"
      ]
    }
  },
  "impactSelection": {
    "fastPlan": "pr",
    "fallbackPlan": "regression",
    "rules": [
      {
        "id": "documentation-only",
        "patterns": [
          "docs/**",
          ".agents/skills/verify-swift-ios-app-flow/**",
          "apps/swift-ios/README.md"
        ],
        "journeys": []
      },
      {
        "id": "onboarding-and-connections",
        "patterns": ["apps/swift-ios/Features/Connection/**"],
        "journeys": ["onboarding-manual", "project-connection-entry"]
      },
      {
        "id": "thread-workspace-tools",
        "patterns": [
          "apps/swift-ios/Features/Files/**",
          "apps/swift-ios/Features/Review/**",
          "apps/swift-ios/Features/SourceControl/**",
          "apps/swift-ios/Features/Terminal/**"
        ],
        "journeys": ["thread-workspace-tools"]
      },
      {
        "id": "composer-skills-popup",
        "patterns": [
          "apps/swift-ios/Features/Chat/FeatureComposerCommandPopover.swift",
          "apps/swift-ios/Features/Chat/FeatureComposerPowerFeatures.swift",
          "apps/swift-ios/Features/Chat/FeatureComposerView.swift"
        ],
        "journeys": ["skills-popup-keyboard-readability"]
      },
      {
        "id": "home-scroll-and-command-palette",
        "patterns": [
          "apps/swift-ios/Features/Workspace/FeatureCommandPaletteGestureInstaller.swift",
          "apps/swift-ios/Features/Workspace/FeatureCommandPaletteModel.swift",
          "apps/swift-ios/Features/Workspace/FeatureCommandPaletteView.swift",
          "apps/swift-ios/Features/Workspace/HomeThreadCollectionView.swift",
          "apps/swift-ios/Features/Workspace/WorkspaceView.swift"
        ],
        "journeys": ["home-thread-list-scrolling", "command-palette-top-drawer"]
      },
      {
        "id": "credential-ingress",
        "patterns": ["apps/swift-ios/App/AppFlowStagedCredentials.swift"],
        "journeys": ["onboarding-manual"]
      },
      {
        "id": "visual-snapshots",
        "patterns": [
          "apps/swift-ios/Tests/FeatureTests/AppFlowVisualSnapshotTests.swift",
          "apps/swift-ios/Tests/FeatureTests/__Snapshots__/**"
        ],
        "journeys": ["onboarding-manual"]
      }
    ]
  },
  "reviewedInventory": [
    {
      "surface": "Choose Project",
      "status": "uncovered",
      "reason": "No deterministic project-picker journey yet."
    },
    {
      "surface": "Settings Build Changelog",
      "status": "uncovered",
      "reason": "Requires a stable local changelog fixture."
    },
    {
      "surface": "T3 Connect",
      "status": "live-only",
      "reason": "Account, relay, and DPoP state must remain real."
    },
    {
      "surface": "Connection enable and remove actions",
      "status": "uncovered",
      "reason": "Destructive actions need disposable connection state."
    },
    {
      "surface": "Add Project clone source menu",
      "status": "uncovered",
      "reason": "Clone-source fixtures are not yet deterministic."
    },
    {
      "surface": "XCTest performAccessibilityAudit",
      "status": "uncovered",
      "reason": "Xcode 26.6 timed out without a valid result bundle for combined, split-screen, and single-screen contrast probes; semantic evidence and pinned XXL snapshots remain required."
    }
  ]
}

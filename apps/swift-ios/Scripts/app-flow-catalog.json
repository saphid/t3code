          "apps/swift-ios/Features/SourceControl/**",
          "apps/swift-ios/Features/Shared/FeatureToolErrorNotice.swift",
          "apps/swift-ios/Features/Shared/FeatureToolErrorPresentation.swift"
        ],
        "journeys": ["safe-tool-content-recovery"]
      },
      {
        "id": "stream-approval-control",

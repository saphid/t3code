+    NSLog(@"[t3-view-proof-native] bridge message dropped: non-main frame url=%@ handler=%@",
+          message.frameInfo.request.URL.absoluteString, message.name);
+    return;
+  }
   if ([message.name isEqualToString:HistoryShimName]) {

+// T3 view proof: plugin views run in sandboxed subframes of the host page.
+// The handler is visible to every frame, so only the main frame may use it, and
+// a subframe may only be navigated by the main frame (or load its srcdoc).
+// A main document URL containing nativeVeto=off turns both off for a baseline run.
+static BOOL RNCT3ViewProofPolicyOff(WKWebView *webView)
+{
+  return [webView.URL.query containsString:@"nativeVeto=off"];
+}
+
 - (void)userContentController:(WKUserContentController *)userContentController
       didReceiveScriptMessage:(WKScriptMessage *)message

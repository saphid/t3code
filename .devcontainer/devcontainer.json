// Dev container for T3 Code. Mirrors CI (ubuntu-24.04, Node 24, Rust stable)
// and the canonical setup in docs/internals/scripts.md: global `vp`, `vp i`.
// Contributor doc: docs/internals/devcontainer.md
{
  "name": "T3 Code",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    // nodeGypDependencies (default true) brings python3/make/g++, which Linux
    // needs for node-pty's node-gyp fallback (its prebuilds are mac/win only).
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    // native/resource-monitor (edition 2024, needs stable >= 1.85). The server
    // degrades gracefully without the binary, but CI checks cargo fmt + test.
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // For the observability compose (otel-collector + Prometheus + Grafana)
    // and the perf-analyzer docker image. See the contributor doc.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb",
    // The perf harness has Linux GPU backends (drm-fdinfo, nvidia-smi) and
    // reports gpuBackend "none" without one; never require a GPU.
    "gpu": "optional"
  },
  "containerEnv": {
    // Keep all runtime state inside the (gitignored) workspace .t3, matching
    // the worktree default. An explicit --home-dir still wins.
    "T3CODE_HOME": "${containerWorkspaceFolder}/.t3",
    // Chromium inside containers needs these; only the perf harness reads it.
    "T3_PERF_CHROME_ARGS": "--no-sandbox --disable-dev-shm-usage"
  },
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  // Runs on prebuild refreshes too, so codespaces start with deps installed
  // and the Vite dep cache warm. ensure:electron repairs exec bits after
  // install, same as CI.
  "updateContentCommand": "vp i && vp run --filter @t3tools/desktop ensure:electron && node apps/web/scripts/warm-dep-cache.ts",
  "forwardPorts": [5733, 13773],
  "portsAttributes": {
    "5733": {
      "label": "t3 web (open via the pairing URL, not the bare origin)",
      "onAutoForward": "notify"
    },
    "13773": {
      "label": "t3 server",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "grafana (observability compose)",
      "onAutoForward": "silent"
    },
    "4318": {
      "label": "otel collector (OTLP http)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "rust-lang.rust-analyzer"],
      "settings": {
        // .repos is a large vendored read-only reference tree; watching it
        // burns CPU and file handles.
        "files.watcherExclude": {
          "**/.repos/**": true,
          "**/.t3/**": true
        },
        "search.exclude": {
          "**/.repos": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}

{
  "schemaVersion": 2,
  "package": "swiftui-delivery",
  "repository": "pingdotgg/t3code",
  "productRepository": "resolved from the current T3 Code checkout",
  "workItemFence": "swiftui-work-item-v2",
  "canonicalTool": "scripts/swiftui-delivery/scripts/swiftui-delivery",
  "simulatorLaneTool": "scripts/swiftui-delivery/scripts/simulator-lane",
  "xcodeBuildMcpVersion": "2.7.0",
  "stateRoot": "~/.local/state/t3/swiftui-delivery",
  "buildStore": "~/.local/share/t3/swiftui-delivery/builds",
  "phonePublicationLease": "~/.local/state/t3/swiftui-delivery/phone-publication.lock",
  "humanActors": [
    "Alex",
    "Saphid"
  ],
  "laneSemantics": {
    "lane": "A named work stream that may contain multiple issues.",
    "workItem": "The delivery state and proof for exactly one issue.",
    "membership": "Every work item names exactly one laneId; an issue cannot appear in two work items."
  },
  "stages": [
    "queued",
    "active",
    "proof-ready",
    "phone-test",
    "accepted",
    "pr-open",
    "landed",
    "cancelled",
    "superseded"
  ],
  "transitions": {
    "queued": [
      "active",
      "cancelled",
      "superseded"
    ],
    "active": [
      "proof-ready",
      "landed",
      "cancelled",
      "superseded"
    ],
    "proof-ready": [
      "phone-test",
      "active",
      "cancelled",
      "superseded"
    ],
    "phone-test": [
      "accepted",
      "active",
      "cancelled",
      "superseded"
    ],
    "accepted": [
      "pr-open",
      "active",
      "cancelled",
      "superseded"
    ],
    "pr-open": [
      "landed",
      "active",
      "cancelled",
      "superseded"
    ],
    "landed": [],
    "cancelled": [],
    "superseded": []
  },
  "dependencyKinds": [
    "stacked-on",
    "ordered-after",
    "collision"
  ],
  "generationModes": [
    "publish-test",
    "publish-dev",
    "open-pr"
  ],
  "generationRoles": {
    "publish-test": [
      "candidate",
      "installed-carry"
    ],
    "publish-dev": [
      "accepted"
    ],
    "open-pr": [
      "candidate"
    ]
  },
  "externalLanding": {
    "transitionFrom": "active",
    "receiptKind": "swiftui-external-landing-receipt",
    "provenanceMode": "external-upstream-landing",
    "bindingProvenance": "external-upstream",
    "prohibitedSideEffects": [
      "productSourceChanged",
      "canonicalStateChanged",
      "githubIssueChanged",
      "pullRequestChanged",
      "labelChanged",
      "buildStarted",
      "simulatorDriven",
      "publicationChanged",
      "deploymentChanged",
      "serviceChanged",
      "physicalPhoneChanged",
      "proofFabricated",
      "phoneAcceptanceRecorded",
      "generationReceiptCreated",
      "workItemPullRequestCreated"
    ]
  },
  "evidencePolicy": {
    "specification": "references/evidence.md",
    "completion": "validate-proof and validate-inspection both pass; generation-plan validation reopens the exact bound artifacts"
  },
  "repoOwnedSpecialists": [
    ".agents/skills/ios-build-hygiene/SKILL.md",
    ".agents/skills/share-video-evidence/SKILL.md"
  ],
  "protectedExternalSpecialists": [
    "swiftui-pro",
    "swift-testing-pro",
    "swift-concurrency-pro",
    "t3code-land-contribution",
    "babysit-pr"
  ],
  "flowPolicy": {
    "model": "Stations have WIP limits; buffers between stations are unbounded.",
    "wipLimits": {
      "activeImplementation": 4,
      "simulatorProof": 3,
      "phoneVerification": 1
    },
    "unboundedBuffers": [
      "queued",
      "implemented awaiting simulator lane",
      "proof-ready awaiting phone verdict",
      "accepted awaiting PR authority"
    ],
    "backlog": {
      "minQueuedReady": 6,
      "sources": [
        "upstream contribution queue issues",
        "React Native mobile app parity gap"
      ],
      "rule": "While any approved worker provider has usable token capacity, keep implementation lanes at their WIP limit: dispatch already-ready queued work into open slots first, then replenish the backlog. A simulator, signing, or phone blocker never idles implementation, test, or review lanes."
    },
    "bufferStaleness": {
      "revalidateImplementedAfterDays": 7,
      "note": "A buffered item pays re-materialization onto the current carry when it advances. Keep items small and file-disjoint so that tax stays low."
    }
  },
  "workItemRepository": "saphid/t3code-personal"
}

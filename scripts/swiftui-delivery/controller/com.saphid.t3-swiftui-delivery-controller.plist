<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.saphid.t3-swiftui-delivery-controller</string>
<key>ProgramArguments</key><array>
  <string>/bin/sh</string><string>-lc</string>
  <string>exec /usr/bin/python3 "$HOME/.local/libexec/t3-swiftui-delivery/controller.py"</string>
</array>
<key>EnvironmentVariables</key><dict>
  <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
</dict>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>120</integer>
<key>ProcessType</key><string>Background</string>
</dict></plist>

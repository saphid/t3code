#!/bin/bash
# Self-verification for the SwiftUI delivery package. Read-only.
# Composes audit-package with the checks it does not cover, including the
# zero-test guard: discovery that finds no tests is a failure, never a pass
# (a missing package once produced a green "Ran 0 tests" and hid a dead
# cutover for four days).
# Exit 0 = clean, 1 = findings, 2 = package broken.
set -u
# Keep direct doctor runs read-only even when Apple's framework Python redirects
# imported bytecode caches outside the package.
export PYTHONDONTWRITEBYTECODE=1
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PKG_DIR=$(dirname "$SCRIPT_DIR")
REPO_ROOT=$(cd "$PKG_DIR/../.." && pwd -P)
CONTRACT="$PKG_DIR/contract.json"
BROKEN=0
FINDINGS=0
note() { printf '%-18s %-8s %s\n' "$1" "$2" "$3"; }
finding() { note "$1" FINDING "$2"; FINDINGS=$((FINDINGS+1)); }
broken()  { note "$1" BROKEN  "$2"; BROKEN=$((BROKEN+1)); }
ok()      { note "$1" ok      "$2"; }

# 1. Contract parses.
if ! python3 -c "import json;json.load(open('$CONTRACT'))" 2>/dev/null; then
  broken contract "contract.json missing or invalid"
else
  ok contract "valid JSON"
fi

# 2. Package integrity via the existing auditor; exit status and payload
#    are both part of the receipt.
AUDIT=$("$SCRIPT_DIR/audit-package" 2>/dev/null)
AUDIT_RC=$?
if [ "$AUDIT_RC" -ne 0 ]; then
  broken audit-package "auditor exited $AUDIT_RC"
elif [ -z "$AUDIT" ]; then
  broken audit-package "auditor produced no output"
elif printf '%s' "$AUDIT" | python3 -c "import json,sys;sys.exit(0 if json.load(sys.stdin).get('ok') else 1)" 2>/dev/null; then
  ok audit-package "$(printf '%s' "$AUDIT" | python3 -c "import json,sys;print('%d files scanned' % json.load(sys.stdin)['filesScanned'])")"
else
  broken audit-package "integrity errors: $(printf '%.200s' "$AUDIT")"
fi

# 3. The four delivery skills exist in this repo.
for s in file-swiftui-lane-issue swiftui-orchestrate swiftui-feature-work swiftui-deliver; do
  if [ -s "$REPO_ROOT/.agents/skills/$s/SKILL.md" ]; then
    ok "skill:$s" present
  else
    broken "skill:$s" "missing $REPO_ROOT/.agents/skills/$s/SKILL.md"
  fi
done

# 4. Canonical tools exist and are executable.
for t in swiftui-delivery compose-generation simulator-lane phone-lease audit-package setup doctor status controller; do
  if [ -x "$SCRIPT_DIR/$t" ]; then
    ok "tool:$t" executable
  else
    broken "tool:$t" "missing or not executable"
  fi
done

# 5. Zero-test guard: unittest discovery must find a nonzero test count
#    and the suite must pass. Capture to a file, never a pipe: the exit
#    status and the summary line are both part of the receipt.
TEST_LOG=$(mktemp /tmp/swiftui-delivery-doctor-tests.XXXXXX)
(cd "$PKG_DIR" && python3 -m unittest discover -s tests > "$TEST_LOG" 2>&1)
TEST_RC=$?
RAN=$(grep -Eo 'Ran [0-9]+ tests?' "$TEST_LOG" | tail -1 | grep -Eo '[0-9]+')
if [ -z "${RAN:-}" ]; then
  broken tests "discovery produced no run summary (rc=$TEST_RC); see $TEST_LOG"
elif [ "$RAN" -eq 0 ]; then
  broken tests "discovery found ZERO tests - treat as package damage, not success"
elif [ "$TEST_RC" -eq 0 ]; then
  ok tests "$RAN tests, all passed"
  rm -f "$TEST_LOG"
else
  broken tests "$RAN tests ran, suite FAILED (rc=$TEST_RC); see $TEST_LOG"
fi

# 6. State roots exist and are writable (setup creates them).
for key in stateRoot buildStore; do
  dir=$(python3 -c "
import json,os
print(os.path.expanduser(json.load(open('$CONTRACT'))['$key']))" 2>/dev/null)
  if [ -n "$dir" ] && [ -d "$dir" ] && [ -w "$dir" ]; then
    ok "$key" "$dir"
  else
    finding "$key" "not present/writable ('$dir'); run scripts/setup"
  fi
done

# 7. GitHub reachability (issue state is canonical there).
if gh auth status >/dev/null 2>&1; then
  ok gh authenticated
else
  finding gh "gh unauthenticated; board reads and writes will fail"
fi

# 8. Deterministic phone watcher: loaded, deployed copy matches vendored
#    source, config present. Continuous Test publication depends on it, so
#    absence or drift is BROKEN, not a finding.
DEPLOYED_WATCHER="$HOME/.local/libexec/t3-swiftui-stream/phone-watch.py"
if ! launchctl print "gui/$(id -u)/com.saphid.t3-swiftui-phone-watch" > /dev/null 2>&1; then
  broken phoneWatcher "watcher not loaded; launchctl enable + bootstrap gui/\$(id -u) ~/Library/LaunchAgents/com.saphid.t3-swiftui-phone-watch.plist"
elif [ ! -f "$DEPLOYED_WATCHER" ]; then
  broken phoneWatcher "deployed watcher script missing at $DEPLOYED_WATCHER"
elif ! cmp -s "$DEPLOYED_WATCHER" "$PKG_DIR/watcher/phone-watch.py"; then
  broken phoneWatcher "deployed watcher differs from vendored source; redeploy watcher/phone-watch.py"
elif [ ! -f "$HOME/.t3/swiftui-stream/watcher-config.json" ]; then
  broken phoneWatcher "watcher-config.json missing (deviceId/teamIdentifier)"
elif ! python3 -c "
import json, sys
d = json.load(open('$HOME/.t3/swiftui-stream/watcher-config.json'))
ok = all(isinstance(d.get(k), str) and d.get(k)
         for k in ('deviceId', 'teamIdentifier'))
sys.exit(0 if ok else 1)" 2>/dev/null; then
  broken phoneWatcher "watcher-config.json must set nonempty deviceId and teamIdentifier"
else
  ok phoneWatcher "loaded, source parity, config valid (device + team pinned)"
fi

# 9. Deterministic coordinator controller: exact source/plist parity, valid
#    runtime configuration, and a loaded LaunchAgent. It is infrastructure and
#    must not rely on a model turn already being alive.
DEPLOYED_CONTROLLER="$HOME/.local/libexec/t3-swiftui-delivery/controller.py"
CONTROLLER_PLIST="com.saphid.t3-swiftui-delivery-controller.plist"
DEPLOYED_CONTROLLER_PLIST="$HOME/Library/LaunchAgents/$CONTROLLER_PLIST"
CONTROLLER_CONFIG="$HOME/.local/state/t3/swiftui-delivery/controller/config.json"
if ! launchctl print \
  "gui/$(id -u)/com.saphid.t3-swiftui-delivery-controller" >/dev/null 2>&1; then
  broken controller "not loaded; run scripts/setup --install"
elif [ ! -f "$DEPLOYED_CONTROLLER" ] || \
     ! cmp -s "$DEPLOYED_CONTROLLER" "$PKG_DIR/controller.py"; then
  broken controller "deployed controller missing or differs from vendored source"
elif [ ! -f "$DEPLOYED_CONTROLLER_PLIST" ] || \
     ! cmp -s "$DEPLOYED_CONTROLLER_PLIST" \
       "$PKG_DIR/controller/$CONTROLLER_PLIST"; then
  broken controller "deployed LaunchAgent differs from vendored source"
elif ! python3 -c "
import json, os, shutil, sys
d=json.load(open('$CONTROLLER_CONFIG'))
ok=(d.get('schemaVersion') == 1 and
    os.path.isdir(d.get('checkout', '')) and
    os.path.isfile(d.get('t3Command', '')) and
    os.access(d.get('t3Command', ''), os.X_OK) and
    os.path.isdir(d.get('t3Home', '')) and
    os.path.isfile(d.get('headroomReporter', '')) and
    shutil.which('gh', path=d.get('path', '')) is not None)
sys.exit(0 if ok else 1)" 2>/dev/null; then
  broken controller "config missing/invalid at $CONTROLLER_CONFIG"
else
  ok controller "loaded, source parity, config valid"
fi

# 10. flowPolicy present so orchestrate can enforce WIP limits.
if python3 -c "
import json,sys
sys.exit(0 if 'flowPolicy' in json.load(open('$CONTRACT')) else 1)" 2>/dev/null; then
  ok flowPolicy "WIP limits and backlog policy declared"
else
  finding flowPolicy "contract has no flowPolicy; orchestrate cannot enforce WIP limits"
fi

echo "----"
if [ "$BROKEN" -gt 0 ]; then
  echo "BROKEN ($BROKEN broken, $FINDINGS findings)"; exit 2
elif [ "$FINDINGS" -gt 0 ]; then
  echo "FINDINGS ($FINDINGS)"; exit 1
else
  echo "CLEAN"; exit 0
fi

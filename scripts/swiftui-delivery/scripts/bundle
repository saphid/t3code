#!/bin/bash
# Produce one versioned tarball of the entire durable process.
set -u
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PKG_DIR=$(dirname "$SCRIPT_DIR")
REPO_ROOT=$(cd "$PKG_DIR/../.." && pwd -P)
HEAD=$(git -C "$REPO_ROOT" rev-parse --short=9 HEAD 2>/dev/null || echo nogit)
OUT="${1:-$HOME/Downloads/swiftui-delivery-$HEAD.tar.gz}"
tar -czf "$OUT" -C "$REPO_ROOT" \
  scripts/swiftui-delivery \
  .agents/skills/file-swiftui-lane-issue \
  .agents/skills/swiftui-orchestrate \
  .agents/skills/swiftui-feature-work \
  .agents/skills/swiftui-deliver \
  .agents/skills/ios-build-hygiene \
  .agents/skills/share-video-evidence \
  .agents/skills/babysit-pr \
  .agents/skills/t3code-land-contribution
rc=$?
if [ "$rc" -eq 0 ]; then
  echo "bundle: $OUT ($(du -h "$OUT" | cut -f1)) @ $HEAD"
  echo "restore: tar -xzf <bundle> -C <repo>; then scripts/swiftui-delivery/scripts/setup --install"
else
  echo "bundle FAILED ($rc)" >&2
fi
exit "$rc"

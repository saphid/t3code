246: 
247: // Acquire strict pre-ready setup before Clerk. Nothing before the Clerk bridge
248: // may yield, or Electron can emit ready before Clerk registers its scheme.
249: const layerDesktopRuntime = layerDesktopClerk.pipe(
250:   Layer.flatMap((clerkContext) =>
251:     layerDesktopApplicationRuntime.pipe(Layer.provideMerge(Layer.succeedContext(clerkContext))),
252:   ),
253:   Layer.provideMerge(DesktopPreReadyPlatform.layer),
254: );
255: 
256: DesktopApp.program.pipe(Effect.provide(layerDesktopRuntime), NodeRuntime.runMain);

